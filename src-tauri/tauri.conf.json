{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "camera-controls",
  "version": "0.1.0",
  "identifier": "com.camera-controls.app",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "tauri": {
    "allowlist": {
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://192.168.1.123:80/*"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Camera Controls",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
