{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "camera-controls",
  "version": "0.1.0",
  "identifier": "com.camera-controls.app",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Camera Controls",
        "width": 800,
        "height": 500
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/camera.ico"
    ]
  }
}
